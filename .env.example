# Copy to .env, compose loads it automatically.
# Pelican uses panel variables instead, not this file.

# Release tag to install from the Bannerlord Coop GitHub releases, for example
# v0.1.6. "latest" follows the newest stable release. Releases older than v0.1.6
# do not publish manifest.json and cannot be installed this way.
#COOP_VERSION=latest

# 0 = never contact GitHub or Workshop, boot whatever is already downloaded.
#AUTO_UPDATE=1

# Optional Steam Workshop item ids to download and load, comma separated.
# Requires a Steam account that owns Bannerlord (app 261550); Steam refuses
# anonymous and non-owning accounts. See "Mods" in the README.
#WORKSHOP_MODS=

# Only used when WORKSHOP_MODS is set. Leave the password empty to type it in
# the console; the first login may also ask for a Steam Guard code.
#STEAM_USERNAME=
#STEAM_PASSWORD=

# Manual module folders go in server-data/mods, one folder per module, each with
# a SubModule.xml. They need no Steam account. See "Mods" in the README.

# World to host. A missing save is created from default_new_game.sav.
#SAVE_NAME=saveauto1

# Password joining players are prompted for. Empty means open.
#SERVER_PASSWORD=

# Minutes between world autosaves. 0 disables them.
#AUTOSAVE_MINUTES=5
