# Copy to .env, compose loads it automatically.
# Pelican uses panel variables instead, not this file.

# Release tag to install from the Bannerlord Coop GitHub releases, for example
# v0.1.6. "latest" follows the newest stable release. Releases older than v0.1.6
# do not publish manifest.json and cannot be installed this way.
#COOP_VERSION=latest

# 0 = never contact GitHub, boot whatever is already downloaded.
#AUTO_UPDATE=1

# Extra module folders go in server-data/mods, one folder per module, each with
# a SubModule.xml. See "Mods" in the README.

# World to host. A missing save is created from default_new_game.sav.
#SAVE_NAME=saveauto1

# Password joining players are prompted for. Empty means open.
#SERVER_PASSWORD=

# Minutes between world autosaves. 0 disables them.
#AUTOSAVE_MINUTES=5
